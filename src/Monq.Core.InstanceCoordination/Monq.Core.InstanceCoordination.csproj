<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <VersionSuffix>$(VersionSuffix)</VersionSuffix>
    <Version Condition="'$(VersionSuffix)' != ''">$(Version)-$(VersionSuffix)</Version>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Authors>Yaroslav Lobov</Authors>
    <Company>MONQ Digital lab</Company>
    <Title>Monq.Core.InstanceCoordination</Title>
    <PackageId>Monq.Core.InstanceCoordination</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>instance coordination scaling rendezvous-hashing microservice</PackageTags>
    <PackageProjectUrl>https://github.com/MONQDL/Monq.Core.InstanceCoordination</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MONQDL/Monq.Core.InstanceCoordination</RepositoryUrl>
    <Description>Application instance coordination and distributed workload ownership for .NET.</Description>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
    <PackageReference Include="Monq.Core.Redis" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Monq.Core.InstanceCoordination.Tests" />
  </ItemGroup>

</Project>
